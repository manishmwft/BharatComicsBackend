<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | Bharat Comics Admin' : 'Bharat Comics Admin' %></title>

  <link href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

 <style>
  :root {
    --brand-blue: #2563eb;
    --brand-blue-dark: #1d4ed8;
    --brand-blue-soft: #eff6ff;
    --brand-border: #dbeafe;
    --brand-text: #0f172a;
    --brand-muted: #64748b;
    --brand-bg: #f8fbff;
    --card-bg: #ffffff;
    --sidebar-bg: linear-gradient(180deg, #1e3a8a 0%, #2563eb 100%);
    --sidebar-text: rgba(255,255,255,0.92);
    --sidebar-text-soft: rgba(255,255,255,0.72);
  }

  body {
    background: var(--brand-bg);
    color: var(--brand-text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .app-shell {
    min-height: 100vh;
  }

  .page-wrapper {
    min-height: 100vh;
    background: linear-gradient(180deg, #f8fbff 0%, #eef5ff 100%);
  }

  .page-body {
    padding-bottom: 32px;
  }

  .navbar-vertical {
    background: var(--sidebar-bg) !important;
    border-right: none !important;
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.18);
  }

  .navbar-brand a {
    color: #fff !important;
    font-size: 1.2rem;
    letter-spacing: 0.2px;
  }

  .navbar-vertical .nav-link {
    color: var(--sidebar-text) !important;
    border-radius: 14px;
    margin: 6px 8px;
    padding: 12px 14px;
    transition: all 0.2s ease;
  }

  .navbar-vertical .nav-link:hover {
    background: rgba(255,255,255,0.12);
    color: #fff !important;
  }

  .navbar-vertical .nav-link.active {
    background: #ffffff !important;
    color: var(--brand-blue) !important;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .navbar-vertical .nav-link.active .nav-link-icon,
  .navbar-vertical .nav-link.active .nav-link-title {
    color: var(--brand-blue) !important;
  }

  .nav-link-icon i {
    font-size: 1rem;
  }

  .navbar.navbar-expand-md {
    background: rgba(255,255,255,0.78);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #e5eefc;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .page-title {
    font-size: 1.7rem;
    font-weight: 700;
    color: #0f172a;
  }

  .card {
    border-radius: 20px;
    border: 1px solid #e7eefb;
    background: var(--card-bg);
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.06);
    overflow: hidden;
  }

  .card-header {
    background: #ffffff;
    border-bottom: 1px solid #edf3ff;
    padding: 18px 22px;
  }

  .card-title {
    font-weight: 700;
    color: #0f172a;
  }

  .card-body {
    padding: 22px;
  }

  .btn {
    border-radius: 12px;
    font-weight: 600;
    padding: 10px 16px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--brand-blue);
    border-color: var(--brand-blue);
  }

  .btn-primary:hover,
  .btn-primary:focus {
    background: var(--brand-blue-dark);
    border-color: var(--brand-blue-dark);
  }

  .btn-outline-primary {
    color: var(--brand-blue);
    border-color: #bfdbfe;
    background: #fff;
  }

  .btn-outline-primary:hover {
    background: var(--brand-blue);
    border-color: var(--brand-blue);
    color: #fff;
  }

  .btn-outline-secondary {
    border-color: #dbe4f0;
    color: #334155;
    background: #fff;
  }

  .btn-outline-secondary:hover {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .btn-outline-warning {
    border-color: #fde68a;
    color: #b45309;
    background: #fff;
  }

  .btn-outline-warning:hover {
    background: #f59e0b;
    border-color: #f59e0b;
    color: #fff;
  }

  .btn-outline-danger {
    border-color: #fecaca;
    color: #dc2626;
    background: #fff;
  }

  .btn-outline-danger:hover {
    background: #dc2626;
    border-color: #dc2626;
    color: #fff;
  }

  .table {
    margin-bottom: 0;
  }

  .table thead th {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748b;
    background: #f8fbff;
    border-bottom: 1px solid #e6eefc;
    padding: 14px 16px;
  }

  .table tbody td {
    padding: 16px;
    vertical-align: middle;
    border-bottom: 1px solid #eef4ff;
  }

  .table tbody tr:hover {
    background: #f8fbff;
  }

  .badge {
    border-radius: 999px;
    padding: 8px 12px;
    font-weight: 700;
  }

  .bg-blue-lt,
  .bg-azure-lt {
    background: #e8f1ff !important;
    color: var(--brand-blue) !important;
  }

  .bg-green-lt {
    background: #eafaf1 !important;
    color: #15803d !important;
  }

  .bg-orange-lt {
    background: #fff4e6 !important;
    color: #c2410c !important;
  }

  .subheader,
  .text-secondary,
  .form-hint {
    color: var(--brand-muted) !important;
  }

  .empty-state {
    padding: 70px 20px;
    text-align: center;
    color: var(--brand-muted);
  }

  .thumb-preview {
    width: 68px;
    height: 68px;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--brand-border);
    background: #fff;
  }

  .page-image-preview {
    width: 110px;
    height: 110px;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid var(--brand-border);
    background: #fff;
  }

  .form-control,
  .form-select,
  textarea.form-control {
    border-radius: 14px;
    border: 1px solid #dbe7fb;
    padding: 12px 14px;
    box-shadow: none;
  }

  .form-control:focus,
  .form-select:focus,
  textarea.form-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .login-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 40%, #ffffff 100%);
  }

  .toast {
    border-radius: 14px;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.16);
  }

  .modal-content {
    border-radius: 20px;
    border: none;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.18);
  }

  .container-xl {
    max-width: 1400px;
  }
</style>
</head>
<body>
  <div class="page app-shell">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <div class="container-fluid">
        <h1 class="navbar-brand navbar-brand-autodark">
          <a href="/admin/dashboard" class="text-white text-decoration-none fw-bold">
           ArenaMansion Comics
          </a>
        </h1>

        <div class="collapse navbar-collapse show">
          <ul class="navbar-nav pt-lg-3">
            <li class="nav-item">
              <a
                class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/admin/dashboard') ? 'active' : '' %>"
                href="/admin/dashboard"
              >
                <span class="nav-link-icon d-md-none d-lg-inline-block">
                  <i class="bi bi-grid"></i>
                </span>
                <span class="nav-link-title">Dashboard</span>
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/comics')) ? 'active' : '' %>"
                href="/admin/comics"
              >
                <span class="nav-link-icon d-md-none d-lg-inline-block">
                  <i class="bi bi-book"></i>
                </span>
                <span class="nav-link-title">Comics</span>
              </a>
            </li>
            <li class="nav-item">
  <a class="nav-link" href="#">
    <span class="nav-link-icon d-md-none d-lg-inline-block">
      <i class="bi bi-bar-chart"></i>
    </span>
    <span class="nav-link-title">
      Analytics
    </span>
  </a>
</li>

<li class="nav-item ms-3">
  <a class="nav-link" href="/admin/analytics/trending">
    <span class="nav-link-title">
      Trending Comics
    </span>
  </a>
</li>

<li class="nav-item ms-3">
  <a class="nav-link" href="/admin/analytics/episodes">
    <span class="nav-link-title">
      Episode Analytics
    </span>
  </a>
</li>

<li class="nav-item ms-3">
  <a class="nav-link" href="/admin/analytics/genres">
    <span class="nav-link-title">
      Genre Analytics
    </span>
  </a>
</li>

<li class="nav-item ms-3">
  <a class="nav-link" href="/admin/analytics/activity">
    <span class="nav-link-title">
      Activity Logs
    </span>
  </a>
</li>
<li class="nav-item">
  <a
    class="nav-link <%= currentPath === '/admin/users' ? 'active' : '' %>"
    href="/admin/users"
  >
    <span class="nav-link-icon d-md-none d-lg-inline-block">
      <i class="bi bi-people"></i>
    </span>

    <span class="nav-link-title">
      Users
    </span>
  </a>
</li>
<li class="nav-item">
  <a
    class="nav-link"
    href="#"
  >
    <span class="nav-link-icon d-md-none d-lg-inline-block">
      <i class="bi bi-cash-stack"></i>
    </span>

    <span class="nav-link-title">
      Monetization
    </span>
  </a>
</li>
<li class="nav-item ms-3">
  <a
    class="nav-link <%= currentPath === '/admin/revenue' ? 'active' : '' %>"
    href="/admin/revenue"
  >
    <span class="nav-link-title">
      Revenue Analytics
    </span>
  </a>
</li>

<li class="nav-item ms-3">
  <a
    class="nav-link <%= currentPath === '/admin/coin-packages' ? 'active' : '' %>"
    href="/admin/coin-packages"
  >
    <span class="nav-link-title">
      Coin Packages
    </span>
  </a>
</li>
          </ul>
        </div>
      </div>
    </aside>

    <div class="page-wrapper">
      <header class="navbar navbar-expand-md d-none d-lg-flex d-print-none">
        <div class="container-xl">
          <div class="navbar-nav flex-row order-md-last">
            <div class="nav-item">
              <a href="/admin/logout" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i>
                Logout
              </a>
            </div>
          </div>

          <div class="collapse navbar-collapse">
            <div>
              <h2 class="page-title mb-0">
                <%= typeof title !== 'undefined' ? title : 'Admin Panel' %>
              </h2>
            </div>
          </div>
        </div>
      </header>

      <div class="page-body">
        <div class="container-xl py-3">
          <%- body %>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="modal modal-blur fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body text-center py-4">
          <i class="bi bi-trash text-danger" style="font-size: 42px;"></i>
          <h3 class="mt-3">Are you sure?</h3>
          <div class="text-secondary">
            This action cannot be undone.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="button" class="btn btn-danger w-100" id="confirmDelete">
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;"></div>

  <script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>

  <script>
    let deleteUrl = "";

    function openDeleteModal(id, baseUrl) {
      deleteUrl = baseUrl + id;
      const modalElement = document.getElementById("deleteModal");
      const modal = new bootstrap.Modal(modalElement);
      modal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
      const confirmDeleteBtn = document.getElementById("confirmDelete");
      if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener("click", function () {
          if (deleteUrl) {
            window.location.href = deleteUrl;
          }
        });
      }
    });

    function showToast(message, type = "success") {
      const container = document.getElementById("toast-container");

      const toast = document.createElement("div");
      toast.className = `toast align-items-center text-bg-${type} border-0 show mb-2`;
      toast.setAttribute("role", "alert");
      toast.setAttribute("aria-live", "assertive");
      toast.setAttribute("aria-atomic", "true");

      toast.innerHTML = `
        <div class="d-flex">
          <div class="toast-body">${message}</div>
          <button
            type="button"
            class="btn-close btn-close-white me-2 m-auto"
            aria-label="Close"
            onclick="this.closest('.toast').remove()"
          ></button>
        </div>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        if (toast && toast.parentNode) {
          toast.remove();
        }
      }, 3000);
    }
  </script>

  
</body>
</html>