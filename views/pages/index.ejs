<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <div class="page-pretitle">
      Comics / Pages
    </div>
<br>
    <h2 class="page-title">
       <%= episode?.title || "Pages" %>
    </h2>
  </div>

  <div class="d-flex align-items-center gap-2">

    <!-- VIEW TOGGLE -->
    <div class="btn-group" role="group">

      <button
        type="button"
        class="btn btn-outline-primary"
        onclick="setPageView('grid')"
      >
        <i class="bi bi-grid-3x3-gap"></i>
      </button>

      <button
        type="button"
        class="btn btn-outline-primary"
        onclick="setPageView('list')"
      >
        <i class="bi bi-list-ul"></i>
      </button>

    </div>

    <!-- BACK -->
    <a
      href="/admin/episodes/<%= comic?.id %>"
      class="btn btn-light"
    >
      <i class="bi bi-arrow-left"></i>
      Back
    </a>

    <!-- ADD PAGE -->
    <a
      href="/admin/pages/add/<%= episode_id %>"
      class="btn btn-primary"
    >
      <i class="bi bi-plus-circle"></i>
      Add Page
    </a>

  </div>
</div>

<!-- CARD -->
<div class="card">

  <!-- CARD HEADER -->
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">
      All Pages
    </h3>

    <span class="badge bg-primary-lt">
      <%= pages.length %> total
    </span>
  </div>

  <!-- ================= GRID VIEW ================= -->
  <div id="gridView">

    <div class="card-body">
      <div class="row">

        <% pages.forEach((page, index) => { %>

          <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body">

                <!-- PAGE NUMBER -->
                <div class="mb-3">
                  <span class="badge bg-primary-lt">
                    Page <%= index + 1 %>
                  </span>
                </div>

                <!-- IMAGE -->
                <div class="text-center mb-3">

                  <% if (page.image_url) { %>

                    <img
                      src="<%= page.image_url %>"
                      class="img-fluid rounded"
                      style="
                        height: 180px;
                        width: auto;
                        object-fit: contain;
                      "
                    >

                  <% } else { %>

                    <div
                      class="border rounded d-flex align-items-center justify-content-center"
                      style="height:180px;"
                    >
                      <i class="bi bi-image text-muted fs-1"></i>
                    </div>

                  <% } %>

                </div>

                <!-- ID -->
                <p
                  class="small text-muted text-break mb-3"
                >
                  <%= page.id %>
                </p>

                <!-- VIEW MODE -->
                <div class="mb-3">

                  <span class="badge bg-azure-lt">
                    <%= comic?.view_mode || "vertical" %>
                  </span>

                </div>

                <!-- ACTIONS -->
                <div class="d-grid gap-2">

                  <a
                    href="/admin/pages/edit/<%= page.id %>"
                    class="btn btn-outline-warning"
                  >
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit
                  </a>

                 <a
  href="/admin/pages/delete/<%= page.id %>"
  class="btn btn-outline-danger"
  onclick="return confirm('Are you sure you want to delete this page?')"
>
  <i class="bi bi-trash me-1"></i>
  Delete
</a>

                </div>

              </div>
            </div>
          </div>

        <% }) %>

      </div>
    </div>
  </div>

  <!-- ================= LIST VIEW ================= -->
  <div id="listView" style="display:none;">

    <div class="table-responsive">

      <table class="table table-hover table-vcenter card-table">

        <thead>
          <tr>
            <th>Page</th>
            <th>Preview</th>
            <th>Comic View Mode</th>
            <th>Image</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody>

          <% pages.forEach((page, index) => { %>

            <tr>

              <!-- PAGE -->
              <td>
                <span class="badge bg-primary-lt">
                  Page <%= index + 1 %>
                </span>
              </td>

              <!-- PREVIEW -->
              <td>

                <% if (page.image_url) { %>

                  <img
                    src="<%= page.image_url %>"
                    class="rounded"
                    style="
                      width: 80px;
                      height: 120px;
                      object-fit: cover;
                    "
                  >

                <% } else { %>

                  <div
                    class="border rounded d-flex align-items-center justify-content-center"
                    style="width:80px;height:120px;"
                  >
                    <i class="bi bi-image"></i>
                  </div>

                <% } %>

              </td>

              <!-- VIEW MODE -->
              <td>

                <span class="badge bg-azure-lt">
                 <%= comic?.view_mode || "vertical" %>
                </span>

              </td>

              <!-- IMAGE URL -->
              <td class="small text-muted text-break">
                <%= page.image_url %>
              </td>

              <!-- ACTIONS -->
              <td class="text-end">

                <div class="btn-list justify-content-end">

                  <a
                    href="/admin/pages/edit/<%= page.id %>"
                    class="btn btn-outline-warning btn-sm"
                  >
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit
                  </a>

                  <a
                    href="javascript:void(0)"
                    class="btn btn-outline-danger btn-sm"
                    onclick="openDeleteModal('<%= page.id %>', '/admin/pages/delete/')"
                  >
                    <i class="bi bi-trash me-1"></i>
                    Delete
                  </a>

                </div>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>

<!-- ================= SCRIPT ================= -->
<script>

  function setPageView(type) {

    const grid = document.getElementById("gridView");
    const list = document.getElementById("listView");

    if (type === "grid") {

      grid.style.display = "block";
      list.style.display = "none";

    } else {

      grid.style.display = "none";
      list.style.display = "block";

    }

    localStorage.setItem("pagesViewMode", type);
  }

  document.addEventListener("DOMContentLoaded", function () {

    const saved =
      localStorage.getItem("pagesViewMode") || "grid";

    setPageView(saved);

  });

</script>